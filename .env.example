# Região onde os modelos do Bedrock estão habilitados.
AWS_REGION=us-east-1

# Credencial do Bedrock. Use UMA das duas opções:
#   1) API key do Bedrock (mais simples):
AWS_BEARER_TOKEN_BEDROCK=
#   2) ou credenciais IAM comuns — nesse caso deixe a linha acima vazia:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Modelo de conversa. Trocar de modelo é trocar esta variável: a Converse API
# mantém o mesmo formato de toolConfig para Nova, Claude, Llama e Mistral.
#
# O prefixo us. é o perfil de inferência entre regiões, que a família Nova exige:
# sem ele, o Bedrock recusa a chamada on-demand. Modelos in-region, como os Gemma,
# não levam prefixo.
#
# `tom eval -m <modelId>` testa um candidato.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Modelo de embeddings.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Onde ficam os CSVs e o PDF de políticas (não versionados).
DATA_DIR=./data

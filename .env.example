# Região onde os modelos do Bedrock estão habilitados.
AWS_REGION=us-east-1

# Credencial do Bedrock. Use UMA das duas opções:
#   1) API key do Bedrock (mais simples):
AWS_BEARER_TOKEN_BEDROCK=
#   2) ou credenciais IAM comuns — nesse caso deixe a linha acima vazia:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Modelo de conversa. Trocar de modelo é trocar esta variável: a Converse API
# do boto3 mantém o mesmo formato de toolConfig para Nova, Claude, Llama e Mistral.
BEDROCK_MODEL_ID=google.gemma-3-4b-it

# Modelo de embeddings.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Onde ficam os CSVs e o PDF de políticas (não versionados).
DATA_DIR=./data

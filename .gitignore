# Local data (not version controlled). Anchored to the repository root: an
# unanchored `data/` also matches src/emporio/data/, which would silently keep
# the whole data package out of every commit.
/data/

# Generated policy index: derived cache, rebuilt in a second by `tom
# build-index`, and derived from `data/`, which is not committed either -- a
# committed index would outlive its source. A float matrix has no useful diff.
/index/

# Python
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
.venv/
venv/
env/
.python-version

# Jupyter
.ipynb_checkpoints/

# Secrets / environment
.env
.env.*
!.env.example

# System / editors
.DS_Store
.vscode/
.idea/
